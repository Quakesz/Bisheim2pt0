<Window x:Class="Bisheim2pt0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bisheim 2.0" Height="560" Width="880"
        MinHeight="520" MinWidth="760"
        Background="{StaticResource BackgroundBrush}"
        Foreground="#F4F0E8" WindowStartupLocation="CenterScreen">
  <Grid Margin="38">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="BISHEIM 2.0" FontSize="36" FontWeight="Bold"/>
      <TextBlock Text="Valheim server launcher" FontSize="16" Foreground="#AAB5BF"/>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,32,0,28" Padding="28" CornerRadius="10"
            Background="{StaticResource PanelBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,28,12"/>
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Checking installation…"
                   Foreground="#AAB5BF" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="Modpack" FontWeight="SemiBold" Margin="0,0,28,12"/>
        <TextBlock x:Name="VersionText" Grid.Row="1" Grid.Column="1" Text="—"
                   Foreground="#AAB5BF" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="2" Text="Server" FontWeight="SemiBold" Margin="0,0,28,12"/>
        <TextBlock x:Name="ServerText" Grid.Row="2" Grid.Column="1" Text="—"
                   Foreground="#AAB5BF" Margin="0,0,0,12"/>
        <ProgressBar x:Name="Progress" Grid.Row="3" Grid.ColumnSpan="2"
                     Height="8" VerticalAlignment="Top" Margin="0,15,0,0"
                     Minimum="0" Maximum="100" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
          <Button x:Name="PlayButton" Content="INSTALL &amp; PLAY" Height="54"
                  FontSize="18" FontWeight="Bold" Background="{StaticResource AccentBrush}"
                  Foreground="#15110C" BorderThickness="0" Click="PlayButton_Click"/>
          <Button x:Name="RepairButton" Content="Repair installation" Margin="0,12,0,0"
                  Height="38" Background="#25313C" Foreground="#F4F0E8"
                  BorderThickness="0" Click="RepairButton_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Grid.Row="2" Text="Mods use a separate profile. A loader is added to Valheim and enabled only by Bisheim."
               Foreground="#7F8C97" HorizontalAlignment="Center"/>
  </Grid>
</Window>
